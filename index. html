<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pump Scanner — Bybit PPR V3</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  background:#070b12;
  color:#edf2f7;
  font-family:Tahoma,Arial,sans-serif
}

.container{
  width:min(1150px,94%);
  margin:20px auto 40px
}

header{
  background:linear-gradient(145deg,#111827,#0b1220);
  border:1px solid #243044;
  border-radius:22px;
  padding:22px;
  box-shadow:0 15px 50px rgba(0,0,0,.35)
}

h1{
  margin:0 0 8px;
  font-size:26px
}

.subtitle{
  color:#98a6ba;
  line-height:1.9
}

.status{
  margin-top:15px;
  padding:12px 14px;
  background:#0a101b;
  border:1px solid #263348;
  border-radius:12px;
  color:#aab6c8
}

.controls{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-top:15px
}

button{
  border:0;
  border-radius:12px;
  padding:12px 17px;
  color:#fff;
  font-weight:bold;
  cursor:pointer;
  background:#2563eb
}

button:hover{
  opacity:.88
}

button.stop{
  background:#991b1b
}

button.test{
  background:#374151
}

button.active{
  background:#15803d
}

.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(135px,1fr));
  gap:10px;
  margin-top:17px
}

.stat{
  background:#0d1420;
  border:1px solid #222e41;
  border-radius:15px;
  padding:14px
}

.label{
  color:#8290a5;
  font-size:12px
}

.num{
  margin-top:5px;
  font-size:23px;
  font-weight:bold
}

.section{
  margin-top:20px
}

.section-title{
  font-size:19px;
  font-weight:bold;
  margin-bottom:12px
}

.results{
  display:grid;
  gap:14px
}

.card{
  background:#0d1420;
  border:1px solid #263348;
  border-radius:19px;
  padding:17px
}

.card.reached{
  border-color:#16a34a;
  box-shadow:0 0 25px rgba(22,163,74,.08)
}

.card.near{
  border-color:#eab308
}

.card.approaching{
  border-color:#3b82f6
}

.top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:10px
}

.symbol{
  font-size:22px;
  font-weight:bold
}

.badge{
  border-radius:999px;
  padding:7px 11px;
  font-size:12px;
  font-weight:bold
}

.badge.reached{
  background:#064e3b;
  color:#6ee7b7
}

.badge.near{
  background:#713f12;
  color:#fde68a
}

.badge.approaching{
  background:#172554;
  color:#93c5fd
}

.badge.below{
  background:#27272a;
  color:#d4d4d8
}

.badge.invalid{
  background:#450a0a;
  color:#fca5a5
}

.price{
  margin-top:12px;
  font-size:25px;
  font-weight:bold
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(155px,1fr));
  gap:9px;
  margin-top:12px
}

.item{
  background:#111927;
  border-radius:12px;
  padding:11px
}

.item small{
  display:block;
  color:#7e8ca1;
  font-size:11px;
  margin-bottom:5px
}

.item strong{
  font-size:14px
}

.zone{
  margin-top:13px;
  padding:14px;
  border:1px dashed #526176;
  border-radius:14px;
  background:#0a111c
}

.zone-title{
  color:#aab7ca;
  font-size:13px;
  margin-bottom:7px
}

.zone-price{
  font-size:21px;
  font-weight:bold
}

.message{
  text-align:center;
  padding:35px 15px;
  color:#8996a9;
  background:#0d1420;
  border:1px dashed #29364a;
  border-radius:18px;
  line-height:2
}

.last{
  margin-top:15px;
  color:#69778c;
  font-size:12px;
  text-align:center
}

.footer{
  text-align:center;
  color:#5e6a7c;
  font-size:11px;
  margin-top:25px
}

@media(max-width:600px){
  .container{width:95%}
  h1{font-size:22px}
  .symbol{font-size:19px}
  .price{font-size:22px}
}
</style>
</head>

<body>

<div class="container">

<header>

  <h1>🚀 Pump Scanner — Bybit</h1>

  <div class="subtitle">
    شناسایی ساختار واقعی بازار:
    <b>PUMP → RED CANDLE → PULLBACK ZONE → RETEST</b>
    <br>
    تایم‌فریم: <b>15M</b> · منبع: <b>Bybit</b>
  </div>

  <div id="status" class="status">
    🟡 در حال اتصال...
  </div>

  <div class="controls">

    <button id="autoBtn" onclick="toggleAuto()">
      ▶️ شروع اسکن خودکار
    </button>

    <button onclick="scanNow()">
      🔎 اسکن همین الان
    </button>

    <button class="test" onclick="testSound()">
      🔊 تست صدا
    </button>

    <button class="stop" onclick="stopAuto()">
      ⏹ توقف
    </button>

  </div>

  <div class="stats">

    <div class="stat">
      <div class="label">ارزهای اسکن‌شده</div>
      <div id="scanned" class="num">0</div>
    </div>

    <div class="stat">
      <div class="label">Pump Setup</div>
      <div id="setups" class="num">0</div>
    </div>

    <div class="stat">
      <div class="label">REACHED 🔥</div>
      <div id="signals" class="num">0</div>
    </div>

    <div class="stat">
      <div class="label">NEAR 🟡</div>
      <div id="near" class="num">0</div>
    </div>

    <div class="stat">
      <div class="label">APPROACHING 🔵</div>
      <div id="approaching" class="num">0</div>
    </div>

    <div class="stat">
      <div class="label">INVALID</div>
      <div id="invalid" class="num">0</div>
    </div>

  </div>

</header>


<div class="section">

  <div class="section-title">
    🎯 Pumpهای معتبر
  </div>

  <div id="results" class="results">

    <div class="message">
      برای شروع، «شروع اسکن خودکار» را بزن.
    </div>

  </div>

  <div id="lastScan" class="last"></div>

</div>


<div class="footer">
  PUMP-SCANNER-BYBIT-PPR-V3
</div>

</div>


<script>

/* =========================================================
   WORKER
========================================================= */

const WORKER =
  "https://pump-scanner.29mah12.workers.dev";


/* =========================================================
   CONFIG
========================================================= */

const SCAN_INTERVAL =
  45000;


/* =========================================================
   STATE
========================================================= */

let autoRunning = false;
let scanBusy = false;
let timer = null;

let audioContext = null;

const alertedSignals =
  new Set();


/* =========================================================
   DOM
========================================================= */

const $ = id =>
  document.getElementById(id);


/* =========================================================
   NUMBER
========================================================= */

function fmt(value,digits=8){

  if(
    value === null ||
    value === undefined ||
    !Number.isFinite(Number(value))
  ){
    return "-";
  }

  return Number(value).toLocaleString(
    "en-US",
    {
      maximumFractionDigits:digits
    }
  );
}


function pct(value){

  if(
    value === null ||
    value === undefined ||
    !Number.isFinite(Number(value))
  ){
    return "-";
  }

  return Number(value).toFixed(2) + "%";
}


function dateTime(value){

  if(!value) return "-";

  return new Date(value).toLocaleString(
    "fa-IR",
    {
      dateStyle:"short",
      timeStyle:"short"
    }
  );
}


/* =========================================================
   AUDIO
========================================================= */

function getAudio(){

  if(!audioContext){

    const AC =
      window.AudioContext ||
      window.webkitAudioContext;

    if(!AC) return null;

    audioContext =
      new AC();
  }

  if(
    audioContext.state === "suspended"
  ){
    audioContext.resume();
  }

  return audioContext;
}


function beep(
  frequency=800,
  duration=.18,
  delay=0
){

  const ctx =
    getAudio();

  if(!ctx) return;

  const oscillator =
    ctx.createOscillator();

  const gain =
    ctx.createGain();

  oscillator.frequency.value =
    frequency;

  oscillator.type =
    "sine";

  gain.gain.setValueAtTime(
    .0001,
    ctx.currentTime + delay
  );

  gain.gain.exponentialRampToValueAtTime(
    .22,
    ctx.currentTime +
    delay +
    .02
  );

  gain.gain.exponentialRampToValueAtTime(
    .0001,
    ctx.currentTime +
    delay +
    duration
  );

  oscillator.connect(gain);
  gain.connect(ctx.destination);

  oscillator.start(
    ctx.currentTime + delay
  );

  oscillator.stop(
    ctx.currentTime +
    delay +
    duration +
    .02
  );
}


function alertSignal(item){

  const id =
    item.id;

  if(
    alertedSignals.has(id)
  ){
    return;
  }

  alertedSignals.add(id);

  beep(880,.20,0);
  beep(1100,.20,.25);
  beep(1400,.28,.50);

  if(
    "Notification" in window &&
    Notification.permission === "granted"
  ){

    new Notification(
      "🔥 Pump Scanner",
      {
        body:
          `${item.symbol} به Pullback Zone رسید`
      }
    );
  }
}


function testSound(){

  beep(700,.18,0);
  beep(1000,.18,.25);
  beep(1300,.25,.50);

  if(
    "Notification" in window &&
    Notification.permission === "default"
  ){

    Notification.requestPermission();
  }
}


/* =========================================================
   HEALTH
========================================================= */

async function health(){

  try{

    const response =
      await fetch(
        WORKER + "/health?_" +
        Date.now(),
        {
          cache:"no-store"
        }
      );

    if(!response.ok){
      throw new Error(
        "HTTP " + response.status
      );
    }

    const data =
      await response.json();

    $("status").textContent =
      `🟢 Worker متصل است — ${data.version}`;

    return true;

  }catch(error){

    $("status").textContent =
      "🔴 Worker در دسترس نیست — " +
      error.message;

    return false;
  }
}


/* =========================================================
   SCAN
========================================================= */

async function scanNow(){

  if(scanBusy){
    return;
  }

  scanBusy = true;

  $("status").textContent =
    "🟡 در حال اسکن Pumpهای واقعی Bybit...";

  try{

    const response =
      await fetch(
        WORKER +
        "/scan?_" +
        Date.now(),
        {
          cache:"no-store"
        }
      );

    if(!response.ok){

      throw new Error(
        "HTTP " + response.status
      );
    }

    const data =
      await response.json();

    if(
      data.error
    ){

      throw new Error(
        data.error
      );
    }

    updateStats(data);

    const results =
      Array.isArray(data.results)
        ? data.results
        : [];

    renderResults(results);

    $("lastScan").textContent =
      "آخرین اسکن: " +
      new Date().toLocaleString(
        "fa-IR"
      );

    $("status").textContent =
      `🟢 اسکن کامل شد — ` +
      `${data.scannedSymbols || 0} ارز بررسی شد`;

    /*
      فقط REACHED هشدار می‌دهد.
    */

    for(
      const item of results
    ){

      if(
        item &&
        item.state === "REACHED"
      ){

        alertSignal(item);
      }
    }

  }catch(error){

    $("status").textContent =
      "🔴 خطا در اسکن — " +
      error.message;

  }finally{

    scanBusy = false;
  }
}


/* =========================================================
   STATS
========================================================= */

function updateStats(data){

  $("scanned").textContent =
    data.scannedSymbols || 0;

  $("setups").textContent =
    data.setups || 0;

  $("signals").textContent =
    data.signals || 0;

  $("near").textContent =
    data.near || 0;

  $("approaching").textContent =
    data.approaching || 0;

  $("invalid").textContent =
    data.invalid || 0;
}


/* =========================================================
   STATE
========================================================= */

function stateInfo(state){

  if(state === "REACHED"){
    return {
      cls:"reached",
      text:"🔥 رسید به Zone"
    };
  }

  if(state === "NEAR"){
    return {
      cls:"near",
      text:"🟡 نزدیک Zone"
    };
  }

  if(state === "APPROACHING"){
    return {
      cls:"approaching",
      text:"🔵 در حال نزدیک شدن"
    };
  }

  if(state === "INVALID"){
    return {
      cls:"invalid",
      text:"🔴 نامعتبر"
    };
  }

  return {
    cls:"below",
    text:"⚪ زیر Zone"
  };
}


/* =========================================================
   RENDER
========================================================= */

function renderResults(results){

  const box =
    $("results");

  /*
    فقط Setupهایی که Pump معتبر
    و Pullback معتبر دارند.
  */

  const valid =
    results.filter(
      x =>
        x &&
        x.pump &&
        x.pullback &&
        x.state !== "INVALID"
    );

  if(!valid.length){

    box.innerHTML = `
      <div class="message">
        🔎 در این اسکن هیچ
        <b>Pump Setup</b>
        معتبری پیدا نشد.
        <br>
        سیستم فقط Pumpهایی را نمایش می‌دهد
        که قوانین V3 را پاس کرده باشند.
      </div>
    `;

    return;
  }

  box.innerHTML =
    valid
      .map(renderCard)
      .join("");
}


/* =========================================================
   CARD
========================================================= */

function renderCard(item){

  const info =
    stateInfo(item.state);

  const pump =
    item.pump || {};

  const pb =
    item.pullback || {};

  return `

    <div class="card ${info.cls}">

      <div class="top">

        <div class="symbol">
          🚀 ${item.symbol}
        </div>

        <div class="badge ${info.cls}">
          ${info.text}
        </div>

      </div>


      <div class="price">
        ${fmt(item.currentPrice,8)}
      </div>


      <div class="grid">

        <div class="item">
          <small>قدرت Pump</small>
          <strong>
            ${pct(pump.percent)}
          </strong>
        </div>

        <div class="item">
          <small>حجم نسبت به میانگین</small>
          <strong>
            ${fmt(pump.volumeRatio,2)}x
          </strong>
        </div>

        <div class="item">
          <small>تعداد کندل Pump</small>
          <strong>
            ${pump.candles ?? "-"}
          </strong>
        </div>

        <div class="item">
          <small>امتیاز Pump</small>
          <strong>
            ${fmt(pump.score,2)}
          </strong>
        </div>

        <div class="item">
          <small>فاصله از Zone</small>
          <strong>
            ${pct(item.distancePercent)}
          </strong>
        </div>

        <div class="item">
          <small>بدنه کندل قرمز</small>
          <strong>
            ${pct(pb.bodyPercent)}
          </strong>
        </div>

      </div>


      <div class="zone">

        <div class="zone-title">
          🎯 محدوده Pullback
        </div>

        <div class="zone-price">

          ${fmt(pb.zoneLow,8)}

          &nbsp; → &nbsp;

          ${fmt(pb.zoneHigh,8)}

        </div>

      </div>


      <div class="grid">

        <div class="item">
          <small>شروع Pump</small>
          <strong>
            ${fmt(pump.basePrice,8)}
          </strong>
        </div>

        <div class="item">
          <small>قیمت Pump</small>
          <strong>
            ${fmt(pump.price,8)}
          </strong>
        </div>

        <div class="item">
          <small>High Pump</small>
          <strong>
            ${fmt(pump.high,8)}
          </strong>
        </div>

        <div class="item">
          <small>Open کندل قرمز</small>
          <strong>
            ${fmt(pb.open,8)}
          </strong>
        </div>

        <div class="item">
          <small>Low کندل قرمز</small>
          <strong>
            ${fmt(pb.low,8)}
          </strong>
        </div>

        <div class="item">
          <small>Close کندل قرمز</small>
          <strong>
            ${fmt(pb.close,8)}
          </strong>
        </div>

      </div>


      <div style="
        margin-top:14px;
        color:#6f7d91;
        font-size:11px;
        line-height:2;
      ">

        🚀 Pump:
        ${dateTime(pump.startTime)}
        →
        ${dateTime(pump.endTime)}

        <br>

        🔴 Pullback:
        ${dateTime(pb.time)}

      </div>

    </div>

  `;
}


/* =========================================================
   AUTO SCAN
========================================================= */

function toggleAuto(){

  if(autoRunning){

    stopAuto();

  }else{

    startAuto();

  }
}


function startAuto(){

  if(autoRunning){
    return;
  }

  autoRunning = true;

  $("autoBtn").textContent =
    "🟢 اسکن خودکار فعال است";

  $("autoBtn").classList.add(
    "active"
  );

  /*
    اولین اسکن بلافاصله
  */

  scanNow();

  /*
    سپس هر 45 ثانیه
  */

  timer =
    setInterval(
      scanNow,
      SCAN_INTERVAL
    );

  if(
    "Notification" in window &&
    Notification.permission === "default"
  ){

    Notification.requestPermission();
  }
}


function stopAuto(){

  autoRunning = false;

  if(timer){

    clearInterval(timer);

    timer = null;
  }

  $("autoBtn").textContent =
    "▶️ شروع اسکن خودکار";

  $("autoBtn").classList.remove(
    "active"
  );

  $("status").textContent =
    "⏹ اسکن خودکار متوقف شد";
}


/* =========================================================
   STARTUP
========================================================= */

health();

</script>

</body>
</html>

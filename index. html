<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pump Scanner — Bybit PPR</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  background:#080b12;
  color:#e8edf7;
  font-family:Tahoma,Arial,sans-serif;
}

.container{
  width:min(1100px,94%);
  margin:25px auto;
}

.header{
  background:linear-gradient(145deg,#111827,#0b1220);
  border:1px solid #202b3d;
  border-radius:22px;
  padding:24px;
  box-shadow:0 15px 45px rgba(0,0,0,.3);
}

h1{
  margin:0 0 8px;
  font-size:27px;
}

.subtitle{
  color:#9aa7bb;
  line-height:1.8;
}

.status{
  margin-top:15px;
  padding:12px 15px;
  border-radius:12px;
  background:#111827;
  color:#9aa7bb;
}

.controls{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:18px;
}

button{
  border:0;
  border-radius:12px;
  padding:12px 18px;
  cursor:pointer;
  color:white;
  background:#2563eb;
  font-weight:bold;
}

button.stop{
  background:#991b1b;
}

button.secondary{
  background:#374151;
}

.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:12px;
  margin-top:18px;
}

.stat{
  background:#0d1420;
  border:1px solid #202b3d;
  border-radius:16px;
  padding:17px;
}

.stat .num{
  font-size:25px;
  font-weight:bold;
  margin-top:5px;
}

.stat .label{
  color:#8d9ab0;
  font-size:13px;
}

.section{
  margin-top:20px;
}

.section-title{
  font-size:19px;
  margin-bottom:12px;
}

.results{
  display:grid;
  gap:14px;
}

.card{
  background:#0d1420;
  border:1px solid #202b3d;
  border-radius:18px;
  padding:18px;
}

.card.reached{
  border-color:#16a34a;
}

.card.near{
  border-color:#eab308;
}

.card.approaching{
  border-color:#3b82f6;
}

.top{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
}

.symbol{
  font-size:22px;
  font-weight:bold;
}

.badge{
  padding:7px 11px;
  border-radius:999px;
  font-size:12px;
  font-weight:bold;
}

.badge.reached{
  background:#064e3b;
  color:#6ee7b7;
}

.badge.near{
  background:#713f12;
  color:#fde68a;
}

.badge.approaching{
  background:#172554;
  color:#93c5fd;
}

.badge.below{
  background:#3f3f46;
  color:#d4d4d8;
}

.badge.invalid{
  background:#450a0a;
  color:#fca5a5;
}

.price{
  font-size:25px;
  font-weight:bold;
  margin-top:14px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
  gap:10px;
  margin-top:14px;
}

.item{
  background:#111827;
  border-radius:12px;
  padding:12px;
}

.item small{
  display:block;
  color:#7f8ca1;
  margin-bottom:5px;
}

.item strong{
  font-size:15px;
}

.zone{
  margin-top:14px;
  border:1px dashed #475569;
  border-radius:14px;
  padding:14px;
}

.zone-title{
  font-weight:bold;
  margin-bottom:8px;
}

.zone-value{
  font-size:20px;
}

.empty{
  text-align:center;
  padding:35px 15px;
  color:#8d9ab0;
  background:#0d1420;
  border:1px dashed #263348;
  border-radius:18px;
}

.footer{
  text-align:center;
  color:#667085;
  font-size:12px;
  padding:25px;
}

@media(max-width:600px){
  .container{width:95%}
  h1{font-size:22px}
  .symbol{font-size:19px}
}
</style>
</head>

<body>

<div class="container">

  <div class="header">

    <h1>🚀 Pump Scanner — Bybit</h1>

    <div class="subtitle">
      شناسایی واقعی:
      <b>PUMP → کندل قرمز → Pullback Zone → Retest</b>
      <br>
      تایم‌فریم اصلی: <b>15M</b>
    </div>

    <div id="status" class="status">
      🟡 در حال اتصال به Worker...
    </div>

    <div class="controls">
      <button onclick="scanNow()">🔎 اسکن بازار</button>
      <button class="stop" onclick="stopScan()">⏹ توقف خودکار</button>
      <button class="secondary" onclick="checkHealth()">❤️ تست اتصال</button>
    </div>

    <div class="stats">

      <div class="stat">
        <div class="label">ارزهای اسکن‌شده</div>
        <div id="scanned" class="num">0</div>
      </div>

      <div class="stat">
        <div class="label">Pump Setup</div>
        <div id="setups" class="num">0</div>
      </div>

      <div class="stat">
        <div class="label">رسیده به Zone</div>
        <div id="signals" class="num">0</div>
      </div>

      <div class="stat">
        <div class="label">نزدیک Zone</div>
        <div id="near" class="num">0</div>
      </div>

      <div class="stat">
        <div class="label">در حال نزدیک شدن</div>
        <div id="approaching" class="num">0</div>
      </div>

    </div>

  </div>

  <div class="section">

    <div class="section-title">
      🎯 فرصت‌های واقعی Pump
    </div>

    <div id="results" class="results">
      <div class="empty">
        هنوز اسکن انجام نشده است.
      </div>
    </div>

  </div>

  <div class="footer">
    Pump Scanner · Bybit · PUMP-SCANNER-BYBIT-PPR-V3
  </div>

</div>

<script>

/* =========================================================
   WORKER
========================================================= */

const WORKER =
  "https://pump-scanner.29mah12.workers.dev";


/* =========================================================
   STATE
========================================================= */

let autoScan = false;
let timer = null;
let busy = false;


/* =========================================================
   HELPERS
========================================================= */

const $ = id =>
  document.getElementById(id);


function number(value, digits=6){

  if(
    value === null ||
    value === undefined ||
    Number.isNaN(Number(value))
  ){
    return "-";
  }

  return Number(value).toLocaleString(
    "en-US",
    {
      maximumFractionDigits:digits
    }
  );
}


function percent(value){

  if(
    value === null ||
    value === undefined
  ){
    return "-";
  }

  return Number(value).toFixed(2) + "%";
}


function time(value){

  if(!value) return "-";

  return new Date(value).toLocaleString(
    "fa-IR",
    {
      dateStyle:"short",
      timeStyle:"short"
    }
  );
}


/* =========================================================
   HEALTH
========================================================= */

async function checkHealth(){

  $("status").textContent =
    "🟡 در حال بررسی Worker...";

  try{

    const response =
      await fetch(
        WORKER + "/health",
        {
          cache:"no-store"
        }
      );

    if(!response.ok){
      throw new Error(
        "HTTP " + response.status
      );
    }

    const data =
      await response.json();

    $("status").textContent =
      `🟢 Worker متصل است — ${data.version}`;

  }catch(error){

    $("status").textContent =
      "🔴 اتصال به Worker برقرار نیست — " +
      error.message;
  }
}


/* =========================================================
   SCAN
========================================================= */

async function scanNow(){

  if(busy) return;

  busy = true;

  $("status").textContent =
    "🟡 در حال اسکن 15M بازار Bybit...";

  try{

    const response =
      await fetch(
        WORKER + "/scan",
        {
          cache:"no-store"
        }
      );

    if(!response.ok){

      throw new Error(
        "HTTP " + response.status
      );
    }

    const data =
      await response.json();

    if(!data.ok && data.error){
      throw new Error(data.error);
    }

    updateStats(data);

    renderResults(
      Array.isArray(data.results)
        ? data.results
        : []
    );

    $("status").textContent =
      `🟢 اسکن انجام شد — ` +
      `${data.scannedSymbols || 0} ارز بررسی شد`;

  }catch(error){

    $("status").textContent =
      "🔴 خطا در اسکن: " +
      error.message;

  }finally{

    busy = false;
  }
}


/* =========================================================
   STATS
========================================================= */

function updateStats(data){

  $("scanned").textContent =
    data.scannedSymbols || 0;

  $("setups").textContent =
    data.setups || 0;

  $("signals").textContent =
    data.signals || 0;

  $("near").textContent =
    data.near || 0;

  $("approaching").textContent =
    data.approaching || 0;
}


/* =========================================================
   STATE LABEL
========================================================= */

function stateInfo(state){

  switch(state){

    case "REACHED":
      return {
        text:"🔥 قیمت به Zone رسیده",
        cls:"reached"
      };

    case "NEAR":
      return {
        text:"🟡 نزدیک Zone",
        cls:"near"
      };

    case "APPROACHING":
      return {
        text:"🔵 در حال نزدیک شدن",
        cls:"approaching"
      };

    case "BELOW_ZONE":
      return {
        text:"⚪ زیر Zone",
        cls:"below"
      };

    case "INVALID":
      return {
        text:"🔴 نامعتبر",
        cls:"invalid"
      };

    default:
      return {
        text:"⏳ انتظار",
        cls:"below"
      };
  }
}


/* =========================================================
   RENDER
========================================================= */

function renderResults(results){

  const box =
    $("results");

  if(!results.length){

    box.innerHTML = `
      <div class="empty">
        <div style="font-size:28px">🔎</div>
        <br>
        در این اسکن هیچ
        <b>Pump Setup</b>
        معتبری پیدا نشد.
        <br><br>
        یعنی فیلتر Pump → Red Candle → Pullback
        در این لحظه مورد معتبری تأیید نکرده است.
      </div>
    `;

    return;
  }


  box.innerHTML =
    results
      .filter(x =>
        x &&
        x.pump &&
        x.pullback
      )
      .map(renderCard)
      .join("");
}


/* =========================================================
   CARD
========================================================= */

function renderCard(item){

  const state =
    stateInfo(item.state);

  const pump =
    item.pump || {};

  const pullback =
    item.pullback || {};

  return `

    <div class="card ${state.cls}">

      <div class="top">

        <div class="symbol">
          🚀 ${item.symbol}
        </div>

        <div class="badge ${state.cls}">
          ${state.text}
        </div>

      </div>

      <div class="price">
        ${number(item.currentPrice,8)}
      </div>

      <div class="grid">

        <div class="item">
          <small>قدرت Pump</small>
          <strong>
            ${percent(pump.percent)}
          </strong>
        </div>

        <div class="item">
          <small>حجم Pump</small>
          <strong>
            ${number(pump.volumeRatio,2)}x
          </strong>
        </div>

        <div class="item">
          <small>تعداد کندل Pump</small>
          <strong>
            ${pump.candles ?? "-"}
          </strong>
        </div>

        <div class="item">
          <small>امتیاز Pump</small>
          <strong>
            ${number(pump.score,2)}
          </strong>
        </div>

        <div class="item">
          <small>فاصله از Zone</small>
          <strong>
            ${percent(item.distancePercent)}
          </strong>
        </div>

        <div class="item">
          <small>درصد بدنه قرمز</small>
          <strong>
            ${percent(pullback.bodyPercent)}
          </strong>
        </div>

      </div>


      <div class="zone">

        <div class="zone-title">
          🎯 Pullback Zone
        </div>

        <div class="zone-value">

          ${number(pullback.zoneLow,8)}

          →

          ${number(pullback.zoneHigh,8)}

        </div>

      </div>


      <div class="grid">

        <div class="item">
          <small>قیمت شروع Pump</small>
          <strong>
            ${number(pump.basePrice,8)}
          </strong>
        </div>

        <div class="item">
          <small>قیمت Pump</small>
          <strong>
            ${number(pump.price,8)}
          </strong>
        </div>

        <div class="item">
          <small>High Pump</small>
          <strong>
            ${number(pump.high,8)}
          </strong>
        </div>

        <div class="item">
          <small>Open کندل قرمز</small>
          <strong>
            ${number(pullback.open,8)}
          </strong>
        </div>

        <div class="item">
          <small>Low کندل قرمز</small>
          <strong>
            ${number(pullback.low,8)}
          </strong>
        </div>

        <div class="item">
          <small>Close کندل قرمز</small>
          <strong>
            ${number(pullback.close,8)}
          </strong>
        </div>

      </div>


      <div style="
        margin-top:14px;
        color:#77849a;
        font-size:12px;
      ">

        ⏱ Pump:
        ${time(pump.startTime)}
        →
        ${time(pump.endTime)}

        <br>

        🔴 Pullback:
        ${time(pullback.time)}

      </div>

    </div>

  `;
}


/* =========================================================
   AUTO SCAN
========================================================= */

function startScan(){

  if(autoScan) return;

  autoScan = true;

  scanNow();

  timer =
    setInterval(
      scanNow,
      45000
    );
}


function stopScan(){

  autoScan = false;

  if(timer){

    clearInterval(timer);

    timer = null;
  }

  $("status").textContent =
    "⏹ اسکن خودکار متوقف شد";
}


/* =========================================================
   START
========================================================= */

checkHealth();

</script>

</body>
</html>

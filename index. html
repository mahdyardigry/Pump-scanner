<!DOCTYPE html><html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pump Scanner — Bybit 15M</title><style>
*{box-sizing:border-box}

body{
  margin:0;
  background:#07111f;
  color:#eaf2ff;
  font-family:Tahoma,Arial,sans-serif;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:20px;
}

.header{
  background:linear-gradient(135deg,#10243c,#0b1729);
  border:1px solid #1e3b5d;
  border-radius:22px;
  padding:24px;
  margin-bottom:18px;
}

h1{margin:0 0 8px;font-size:28px}
.sub{color:#91a8c2;line-height:1.8}

.status{
  margin-top:15px;
  padding:12px 15px;
  border-radius:12px;
  background:#0d1d30;
  border:1px solid #244564;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px;
}

.card{
  background:#0c1a2b;
  border:1px solid #1b3652;
  border-radius:18px;
  padding:18px;
}

.card h2{
  margin-top:0;
  font-size:18px;
}

button{
  border:0;
  border-radius:12px;
  padding:12px 18px;
  cursor:pointer;
  font-weight:bold;
  margin:4px;
}

.start{background:#19c37d;color:#04140d}
.stop{background:#ef5350;color:white}
.test{background:#34495e;color:white}

input[type="text"]{
  width:100%;
  padding:13px;
  border-radius:11px;
  border:1px solid #294763;
  background:#071525;
  color:white;
  outline:none;
  margin-bottom:10px;
}

input[type="range"]{width:100%}

.value{
  color:#55d6ff;
  font-weight:bold;
}

#results{
  display:grid;
  gap:12px;
}

.signal{
  border:1px solid #285273;
  background:#0a1828;
  border-radius:16px;
  padding:16px;
}

.signal.strong{
  border-color:#19c37d;
}

.signal h3{
  margin:0 0 8px;
}

.row{
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-bottom:1px solid #152c42;
}

.row:last-child{border-bottom:0}

.good{color:#32df96}
.warn{color:#ffc857}
.bad{color:#ff7070}

.empty{
  text-align:center;
  color:#7890a8;
  padding:30px;
}

.small{
  font-size:13px;
  color:#7f96ae;
  line-height:1.8;
}

footer{
  text-align:center;
  color:#60758d;
  padding:25px 0;
}

@media(max-width:600px){
  .container{padding:12px}
  h1{font-size:22px}
  button{width:100%;margin:4px 0}
}
</style></head><body><div class="container">  <section class="header">
    <h1>🚀 Pump Scanner</h1><div class="sub">
  اسکنر هوشمند پامپ بر پایه داده واقعی Bybit<br>
  تایم‌فریم اصلی: <b>15 دقیقه</b><br>
  شناسایی پامپ → کندل قرمز اصلاحی → برگشت قیمت به محدوده کندل
</div>

<div id="status" class="status">
  🟡 در حال بررسی اتصال به Worker...
</div>

  </section>  <div class="grid"><section class="card">
  <h2>🎛 کنترل اسکن</h2>

  <button class="start" onclick="startScanner()">
    ▶️ شروع اسکن
  </button>

  <button class="stop" onclick="stopScanner()">
    ⏹ توقف
  </button>

  <div class="small">
    اسکن تا زمانی که دکمه «توقف» زده نشود ادامه پیدا می‌کند.
  </div>

  <div style="margin-top:15px">
    وضعیت:
    <span id="scanState" class="value">متوقف</span>
  </div>

  <div style="margin-top:10px">
    آخرین اسکن:
    <span id="lastScan" class="value">—</span>
  </div>
</section>

<section class="card">
  <h2>🔊 هشدار صوتی</h2>

  <button id="soundButton" class="test" onclick="toggleSound()">
    🔇 صدا خاموش
  </button>

  <button class="test" onclick="testSound()">
    🔔 تست صدا
  </button>

  <div style="margin-top:15px">
    شدت صدا:
    <span id="volumeValue" class="value">70%</span>
  </div>

  <input
    id="volume"
    type="range"
    min="0"
    max="100"
    value="70"
    oninput="updateVolume()"
  >
</section>

<section class="card">
  <h2>🔎 تحلیل دستی</h2>

  <input
    id="symbol"
    type="text"
    placeholder="مثلاً BTCUSDT"
  >

  <button class="test" onclick="analyzeSymbol()">
    🔎 تحلیل ارز
  </button>

  <div id="manualResult" class="small">
    نماد موردنظر را وارد کنید.
  </div>
</section>

  </div>  <section class="card" style="margin-top:16px"><h2>📡 سیگنال‌های شناسایی‌شده</h2>

<div id="results">
  <div class="empty">
    هنوز سیگنالی شناسایی نشده است.
  </div>
</div>

  </section>  <footer>
    Pump Scanner · Bybit · 15M
  </footer></div><script>

const WORKER_URL =
  "https://pump-scanner.29mah12.workers.dev";

let scanning = false;
let timer = null;

let soundEnabled =
  localStorage.getItem("pump_sound") !== "0";

let volume =
  Number(localStorage.getItem("pump_volume") || 70);

const seenSignals = new Set();

const statusEl =
  document.getElementById("status");

const scanState =
  document.getElementById("scanState");

const lastScan =
  document.getElementById("lastScan");

const resultsEl =
  document.getElementById("results");

const manualResult =
  document.getElementById("manualResult");

const volumeEl =
  document.getElementById("volume");

const volumeValue =
  document.getElementById("volumeValue");

const soundButton =
  document.getElementById("soundButton");


/* =========================
   اتصال Worker
========================= */

async function checkHealth(){

  try{

    const r =
      await fetch(
        WORKER_URL + "/health",
        {cache:"no-store"}
      );

    if(!r.ok)
      throw new Error("HTTP " + r.status);

    const data =
      await r.json();

    statusEl.innerHTML =
      "🟢 اتصال برقرار است — " +
      (data.source || "Bybit") +
      " · " +
      (data.timeframe || "15m");

  }catch(e){

    statusEl.innerHTML =
      "🔴 اتصال به Worker برقرار نیست";

    console.error(e);
  }
}


/* =========================
   صدا
========================= */

function updateSoundUI(){

  soundButton.textContent =
    soundEnabled
      ? "🔊 صدا روشن"
      : "🔇 صدا خاموش";

  volumeEl.value = volume;

  volumeValue.textContent =
    volume + "%";
}

function toggleSound(){

  soundEnabled =
    !soundEnabled;

  localStorage.setItem(
    "pump_sound",
    soundEnabled ? "1" : "0"
  );

  updateSoundUI();

  if(soundEnabled)
    testSound();
}

function updateVolume(){

  volume =
    Number(volumeEl.value);

  localStorage.setItem(
    "pump_volume",
    String(volume)
  );

  volumeValue.textContent =
    volume + "%";
}

function beep(
  frequency=880,
  duration=180
){

  if(!soundEnabled || volume <= 0)
    return;

  try{

    const AudioContext =
      window.AudioContext ||
      window.webkitAudioContext;

    const ctx =
      new AudioContext();

    const osc =
      ctx.createOscillator();

    const gain =
      ctx.createGain();

    osc.frequency.value =
      frequency;

    osc.type = "sine";

    gain.gain.value =
      (volume / 100) * 0.15;

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.start();

    setTimeout(()=>{

      osc.stop();
      ctx.close();

    }, duration);

  }catch(e){

    console.error(e);
  }
}

function testSound(){

  beep(880,180);

  setTimeout(
    ()=>beep(1100,220),
    220
  );
}


/* =========================
   شروع اسکن
========================= */

async function startScanner(){

  if(scanning)
    return;

  scanning = true;

  scanState.textContent =
    "در حال اسکن...";

  scanState.className =
    "value good";

  await runScan();

  timer =
    setInterval(
      runScan,
      15000
    );
}


/* =========================
   توقف
========================= */

function stopScanner(){

  scanning = false;

  if(timer){

    clearInterval(timer);
    timer = null;
  }

  scanState.textContent =
    "متوقف";

  scanState.className =
    "value bad";
}


/* =========================
   اسکن Worker
========================= */

async function runScan(){

  if(!scanning)
    return;

  try{

    const r =
      await fetch(
        WORKER_URL +
        "/scan?t=" +
        Date.now(),
        {cache:"no-store"}
      );

    if(!r.ok)
      throw new Error(
        "HTTP " + r.status
      );

    const data =
      await r.json();

    lastScan.textContent =
      new Date().toLocaleTimeString(
        "fa-IR"
      );

    renderScan(data);

  }catch(e){

    console.error(e);

    statusEl.innerHTML =
      "🟠 Worker متصل است ولی اسکن با خطا مواجه شد";
  }
}


/* =========================
   نمایش نتایج
========================= */

function renderScan(data){

  let items = [];

  if(Array.isArray(data))
    items = data;

  else if(Array.isArray(data.results))
    items = data.results;

  else if(Array.isArray(data.signals))
    items = data.signals;

  if(!items.length)
    return;

  for(const item of items){

    const symbol =
      String(
        item.symbol ||
        item.ticker ||
        ""
      ).toUpperCase();

    if(!symbol)
      continue;

    const signalId =
      symbol +
      "_" +
      (
        item.signalTime ||
        item.timestamp ||
        item.time ||
        ""
      );

    if(seenSignals.has(signalId))
      continue;

    seenSignals.add(signalId);

    addSignal(item);

    beep(1000,180);

    setTimeout(
      ()=>beep(1300,250),
      200
    );
  }
}


/* =========================
   کارت سیگنال
========================= */

function addSignal(item){

  const symbol =
    String(
      item.symbol ||
      item.ticker ||
      "UNKNOWN"
    ).toUpperCase();

  const pump =
    item.pumpPercent ??
    item.pump ??
    item.changePercent ??
    "—";

  const red =
    item.redCandlePercent ??
    item.pullbackPercent ??
    item.correctionPercent ??
    "—";

  const target =
    item.targetPrice ??
    item.retestPrice ??
    item.candlePrice ??
    "—";

  const price =
    item.price ??
    item.currentPrice ??
    "—";

  const score =
    item.score ??
    item.confidence ??
    "—";

  const div =
    document.createElement("div");

  div.className =
    "signal strong";

  div.innerHTML = `

    <h3>🚨 ${escapeHtml(symbol)}</h3>

    <div class="row">
      <span>پامپ</span>
      <b class="good">
        ${escapeHtml(pump)}%
      </b>
    </div>

    <div class="row">
      <span>کندل قرمز</span>
      <b class="warn">
        ${escapeHtml(red)}
      </b>
    </div>

    <div class="row">
      <span>قیمت فعلی</span>
      <b>
        ${escapeHtml(price)}
      </b>
    </div>

    <div class="row">
      <span>محدوده بازگشت</span>
      <b>
        ${escapeHtml(target)}
      </b>
    </div>

    <div class="row">
      <span>امتیاز</span>
      <b class="good">
        ${escapeHtml(score)}
      </b>
    </div>

    <div class="small">
      🕒 ${new Date().toLocaleString("fa-IR")}
    </div>
  `;

  if(
    resultsEl.firstElementChild &&
    resultsEl.firstElementChild.classList.contains("empty")
  ){
    resultsEl.innerHTML = "";
  }

  resultsEl.prepend(div);
}


/* =========================
   تحلیل دستی
========================= */

async function analyzeSymbol(){

  let symbol =
    document
      .getElementById("symbol")
      .value
      .trim()
      .toUpperCase();

  if(!symbol)
    return;

  manualResult.innerHTML =
    "⏳ در حال تحلیل " +
    escapeHtml(symbol) +
    "...";

  try{

    const r =
      await fetch(
        WORKER_URL +
        "/analyze?symbol=" +
        encodeURIComponent(symbol),
        {cache:"no-store"}
      );

    const data =
      await r.json();

    manualResult.innerHTML =
      "<pre style='white-space:pre-wrap;direction:ltr;text-align:left'>" +
      escapeHtml(
        JSON.stringify(
          data,
          null,
          2
        )
      ) +
      "</pre>";}catch(e){

manualResult.innerHTML =
  "❌ خطا در تحلیل ارز";

console.error(e);

}
}

/* =========================
امنیت نمایش متن
========================= */

function escapeHtml(value){

return String(value)
.replaceAll("&","&")
.replaceAll("<","<")
.replaceAll(">",">")
.replaceAll('"',""")
.replaceAll("'","'");
}

/* =========================
شروع اولیه
========================= */

updateSoundUI();
checkHealth();

</script></body>
</html>

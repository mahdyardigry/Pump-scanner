  </div></div><footer>Pump Scanner — Bybit Pullback Radar<br>

تحلیل بر اساس داده‌های بازار Bybit و تایم‌فریم 15 دقیقه

</footer></div><script>

/* =========================================================
   CONFIG
========================================================= */

/*
  آدرس Worker را بعد از Deploy اینجا قرار می‌دهیم.

  مثال:
  https://pump-scanner.xxx.workers.dev

  فعلاً صفحه به صورت خودکار از همان Origin استفاده می‌کند.
*/

const WORKER_URL =
  window.WORKER_URL ||
  "";


/* =========================================================
   STATE
========================================================= */

let scanning = false;

let scanTimer = null;

let soundEnabled =
  localStorage.getItem(
    "pump_sound_enabled"
  ) !== "false";

let volume =
  Number(
    localStorage.getItem(
      "pump_sound_volume"
    )
  );

if (
  !Number.isFinite(volume)
) {
  volume = 70;
}

let alertedSetups =
  new Set();


/* =========================================================
   DOM
========================================================= */

const startBtn =
  document.getElementById(
    "startBtn"
  );

const stopBtn =
  document.getElementById(
    "stopBtn"
  );

const soundBtn =
  document.getElementById(
    "soundBtn"
  );

const statusDot =
  document.getElementById(
    "statusDot"
  );

const statusText =
  document.getElementById(
    "statusText"
  );

const scanState =
  document.getElementById(
    "scanState"
  );

const volumeInput =
  document.getElementById(
    "volume"
  );

const volumeValue =
  document.getElementById(
    "volumeValue"
  );

const signalList =
  document.getElementById(
    "signalList"
  );


/* =========================================================
   WORKER URL
========================================================= */

function api(path){

  /*
    اگر Worker روی همان دامنه باشد:
    /scan

    اگر Worker جدا باشد:
    WORKER_URL + /scan
  */

  if(WORKER_URL){

    return (
      WORKER_URL.replace(/\/+$/,"") +
      path
    );
  }

  return path;
}


/* =========================================================
   SOUND
========================================================= */

let audioContext = null;


function ensureAudio(){

  if(!audioContext){

    const AudioCtx =
      window.AudioContext ||
      window.webkitAudioContext;

    if(!AudioCtx){
      return null;
    }

    audioContext =
      new AudioCtx();
  }

  if(
    audioContext.state ===
    "suspended"
  ){
    audioContext.resume();
  }

  return audioContext;
}


function beep(
  frequency = 880,
  duration = 180
){

  if(!soundEnabled){
    return;
  }

  const ctx =
    ensureAudio();

  if(!ctx){
    return;
  }

  const oscillator =
    ctx.createOscillator();

  const gain =
    ctx.createGain();

  oscillator.type =
    "sine";

  oscillator.frequency.value =
    frequency;

  const level =
    Math.max(
      0,
      Math.min(
        1,
        volume / 100
      )
    );

  gain.gain.setValueAtTime(
    0,
    ctx.currentTime
  );

  gain.gain.linearRampToValueAtTime(
    level * 0.18,
    ctx.currentTime + 0.01
  );

  gain.gain.linearRampToValueAtTime(
    0,
    ctx.currentTime +
      duration / 1000
  );

  oscillator.connect(gain);

  gain.connect(
    ctx.destination
  );

  oscillator.start();

  oscillator.stop(
    ctx.currentTime +
    duration / 1000 +
    0.02
  );
}


function alertSound(){

  if(!soundEnabled){
    return;
  }

  beep(880,160);

  setTimeout(
    () => beep(1100,180),
    190
  );

  setTimeout(
    () => beep(1320,240),
    400
  );
}


function testSound(){

  soundEnabled = true;

  localStorage.setItem(
    "pump_sound_enabled",
    "true"
  );

  updateSoundButton();

  alertSound();
}


/* =========================================================
   SOUND TOGGLE
========================================================= */

function toggleSound(){

  soundEnabled =
    !soundEnabled;

  localStorage.setItem(
    "pump_sound_enabled",
    String(soundEnabled)
  );

  updateSoundButton();

  if(soundEnabled){
    ensureAudio();
    beep(900,150);
  }
}


function updateSoundButton(){

  soundBtn.textContent =
    soundEnabled
      ? "🔊 صدا روشن"
      : "🔇 صدا خاموش";

  soundBtn.style.opacity =
    soundEnabled
      ? "1"
      : ".65";
}


/* =========================================================
   VOLUME
========================================================= */

function updateVolume(){

  volume =
    Number(
      volumeInput.value
    );

  localStorage.setItem(
    "pump_sound_volume",
    String(volume)
  );

  volumeValue.textContent =
    volume + "%";
}


/* =========================================================
   STATUS
========================================================= */

function setOnline(){

  statusDot.className =
    "dot online";

  statusText.textContent =
    "🟢 اتصال به Bybit Worker برقرار است";
}


function setOffline(message){

  statusDot.className =
    "dot offline";

  statusText.textContent =
    message ||
    "🔴 اتصال به Worker برقرار نیست";
}


/* =========================================================
   HEALTH CHECK
========================================================= */

async function checkHealth(){

  try{

    const response =
      await fetch(
        api("/health"),
        {
          cache:"no-store"
        }
      );

    if(!response.ok){
      throw new Error(
        "HTTP " +
        response.status
      );
    }

    const data =
      await response.json();

    if(data.ok){

      setOnline();

      return true;
    }

    throw new Error(
      "Worker not ready"
    );

  }catch(error){

    setOffline(
      "🔴 اتصال به Worker برقرار نیست"
    );

    return false;
  }
}


/* =========================================================
   START
========================================================= */

async function startScanner(){

  if(scanning){
    return;
  }

  ensureAudio();

  const online =
    await checkHealth();

  if(!online){

    alert(
      "Worker در دسترس نیست.\n\n" +
      "ابتدا Worker را Deploy کنید."
    );

    return;
  }

  scanning = true;

  startBtn.disabled =
    true;

  stopBtn.disabled =
    false;

  scanState.textContent =
    "🟢 اسکن فعال است";

  scanInfo.textContent =
    "اسکن بازار Bybit شروع شد...";

  /*
    بلافاصله یک اسکن.
  */

  await performScan();

  /*
    ادامه اسکن تا زمانی که
    کاربر Stop نزده است.
  */

  if(scanning){

    scanTimer =
      setTimeout(
        scannerLoop,
        45000
      );
  }
}


/* =========================================================
   LOOP
========================================================= */

async function scannerLoop(){

  if(!scanning){
    return;
  }

  await performScan();

  if(scanning){

    scanTimer =
      setTimeout(
        scannerLoop,
        45000
      );
  }
}


/* =========================================================
   STOP
========================================================= */

function stopScanner(){

  scanning = false;

  if(scanTimer){

    clearTimeout(
      scanTimer
    );

    scanTimer = null;
  }

  startBtn.disabled =
    false;

  stopBtn.disabled =
    true;

  scanState.textContent =
    "⏹ اسکن متوقف است";

  scanInfo.textContent +=
    " — اسکن توسط کاربر متوقف شد.";
}


/* =========================================================
   PERFORM SCAN
========================================================= */

async function performScan(){

  if(!scanning){
    return;
  }

  scanState.textContent =
    "🔄 در حال اسکن بازار Bybit...";

  try{

    const response =
      await fetch(
        api("/scan"),
        {
          cache:"no-store"
        }
      );

    if(!response.ok){

      throw new Error(
        "HTTP " +
        response.status
      );
    }

    const data =
      await response.json();

    if(
      !data ||
      !Array.isArray(
        data.results
      )
    ){

      throw new Error(
        "پاسخ نامعتبر Worker"
      );
    }

    setOnline();

    updateStats(data);

    renderSignals(
      data.results
    );

    processAlerts(
      data.results
    );

    scanState.textContent =
      "🟢 اسکن فعال است";

  }catch(error){

    console.error(
      "Scan error:",
      error
    );

    setOffline(
      "🔴 خطا در ارتباط با Worker"
    );

    scanState.textContent =
      "⚠️ خطا در اسکن — تلاش مجدد خودکار";

    scanInfo.textContent =
      "خطا: " +
      error.message;
  }
}


/* =========================================================
   STATS
========================================================= */

function updateStats(data){

  document.getElementById(
    "scanned"
  ).textContent =
    data.scannedSymbols ??
    0;

  document.getElementById(
    "setups"
  ).textContent =
    data.setups ??
    0;

  document.getElementById(
    "near"
  ).textContent =
    data.near ??
    0;

  document.getElementById(
    "signals"
  ).textContent =
    data.signals ??
    0;

  const time =
    data.timestamp
      ? new Date(
          data.timestamp
        ).toLocaleTimeString(
          "fa-IR"
        )
      : "-";

  scanInfo.textContent =
    `آخرین اسکن: ${time} | ` +
    `بررسی: ${data.scannedSymbols ?? 0} ارز | ` +
    `Setup: ${data.setups ?? 0} | ` +
    `رسیده به محدوده: ${data.signals ?? 0}`;
}


/* =========================================================
   ALERT
========================================================= */

function processAlerts(results){

  for(
    const item of results
  ){

    if(
      item.state !==
      "REACHED"
    ){
      continue;
    }

    if(
      alertedSetups.has(
        item.id
      )
    ){
      continue;
    }

    alertedSetups.add(
      item.id
    );

    alertSound();

    /*
      Browser Notification
      فقط اگر قبلاً اجازه داده شده باشد.
    */

    notifyBrowser(item);
  }
}


/* =========================================================
   BROWSER NOTIFICATION
========================================================= */

async function requestNotificationPermission(){

  if(
    "Notification" in window &&
    Notification.permission ===
      "default"
  ){

    try{

      await Notification.requestPermission();

    }catch(e){}
  }
}


function notifyBrowser(item){

  if(
    !("Notification" in window)
  ){
    return;
  }

  if(
    Notification.permission !==
      "granted"
  ){
    return;
  }

  try{

    new Notification(
      "🚨 Pump Pullback Signal",
      {
        body:
          `${item.symbol} به محدوده Pullback رسید\n` +
          `قیمت: ${formatPrice(item.currentPrice)}`,
        tag:
          "pump-" +
          item.id
      }
    );

  }catch(e){}
}


/* =========================================================
   RENDER SIGNALS
========================================================= */

function renderSignals(results){

  /*
    فقط Setupهای معتبر و فعال
    را نمایش می‌دهیم.
  */

  const visible =
    results.filter(
      x =>
        x.state !==
        "INVALID"
    );

  if(!visible.length){

    signalList.innerHTML = `
      <div class="empty">
        🔎 در این اسکن هنوز Setup معتبر
        Pump Pullback پیدا نشد.
      </div>
    `;

    return;
  }

  signalList.innerHTML =
    visible
      .map(renderSignal)
      .join("");
}


/* =========================================================
   SIGNAL CARD
========================================================= */

function renderSignal(item){

  const stateInfo =
    getStateInfo(
      item.state
    );

  const pump =
    item.pump || {};

  const pullback =
    item.pullback || {};

  return `
    <div class="signal ${stateInfo.class}">

      <div class="signal-top">

        <div class="symbol">
          ${escapeHtml(
            item.symbol
          )}
        </div>

        <div

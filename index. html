        </div>

      </div>


      <div class="zone">

        <div class="zone-title">
          🎯 محدوده Pullback
        </div>

        <div class="zone-value">
          ${formatPrice(
            pullback.zoneLow
          )}
          تا
          ${formatPrice(
            pullback.zoneHigh
          )}
        </div>

      </div>


      <div class="scan-info">

        🔴 کندل اصلاحی:
        Open
        ${formatPrice(
          pullback.open
        )}
        · Close
        ${formatPrice(
          pullback.close
        )}

        <br>

        📈 سقف Pump:
        ${formatPrice(
          pump.high
        )}

        <br>

        🕐 تایم‌فریم:
        15 دقیقه

      </div>

    </div>
  `;
}


/* =========================================================
   STATE INFO
========================================================= */

function getStateInfo(state){

  switch(state){

    case "REACHED":

      return {
        class:"reached",
        text:"🚨 رسید به محدوده"
      };

    case "NEAR":

      return {
        class:"near",
        text:"🟡 نزدیک محدوده"
      };

    case "APPROACHING":

      return {
        class:"approaching",
        text:"🔵 در مسیر محدوده"
      };

    case "BELOW_ZONE":

      return {
        class:"",
        text:"⬇️ زیر محدوده"
      };

    default:

      return {
        class:"",
        text:"⏳ در انتظار"
      };
  }
}


/* =========================================================
   FORMAT
========================================================= */

function formatNumber(value){

  const n =
    Number(value);

  if(
    !Number.isFinite(n)
  ){
    return "0";
  }

  if(
    Math.abs(n) >= 100
  ){
    return n.toFixed(1);
  }

  if(
    Math.abs(n) >= 1
  ){
    return n.toFixed(2);
  }

  return n.toFixed(4);
}


function formatPrice(value){

  const n =
    Number(value);

  if(
    !Number.isFinite(n)
  ){
    return "—";
  }

  if(
    n >= 1000
  ){
    return n.toLocaleString(
      "en-US",
      {
        maximumFractionDigits:2
      }
    );
  }

  if(
    n >= 1
  ){
    return n.toFixed(4);
  }

  if(
    n >= .01
  ){
    return n.toFixed(6);
  }

  return n.toPrecision(6);
}


/* =========================================================
   SECURITY
========================================================= */

function escapeHtml(value){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );
}



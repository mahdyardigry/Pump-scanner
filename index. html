      <div class="signal-grid">

        <div class="metric">
          <div class="metric-label">
            قیمت فعلی
          </div>

          <div class="metric-value">
            ${formatPrice(
              item.currentPrice
            )}
          </div>
        </div>


        <div class="metric">
          <div class="metric-label">
            رشد Pump
          </div>

          <div class="metric-value green">
            +${formatNumber(
              pump.percent
            )}%
          </div>
        </div>


        <div class="metric">
          <div class="metric-label">
            حجم Pump
          </div>

          <div class="metric-value">
            ${
              pump.volumeRatio
                ? formatNumber(
                    pump.volumeRatio
                  ) + "x"
                : "—"
            }
          </div>
        </div>


        <div class="metric">
          <div class="metric-label">
            فاصله تا Zone
          </div>

          <div class="metric-value">
            ${
              item.state ===
              "REACHED"
                ? "رسیده"
                :
                  formatNumber(
                    item.distancePercent
                  ) + "%"
            }

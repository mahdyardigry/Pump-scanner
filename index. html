  font-weight:bold;
}

.reached{
  background:#145d3a;
  color:#7ff0b0;
}

.near{
  background:#685515;
  color:#ffe78a;
}

.approaching{
  background:#174b69;
  color:#82d9ff;
}

.below{
  background:#3a354c;
  color:#cfc2ff;
}

.invalid{
  background:#542525;
  color:#ffaaaa;
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
}

.info{
  background:#101f32;
  border-radius:10px;
  padding:10px;
}

.info small{
  display:block;
  color:#849bb2;
  margin-bottom:5px;
  font-size:11px;
}

.info strong{
  font-size:14px;
}

.pump-box{
  margin-top:10px;
  padding:12px;
  border-radius:12px;
  background:#10233a;
}

.pump-title{
  font-weight:bold;
  margin-bottom:8px;
}

.footer{
  text-align:center;
  color:#71869c;
  font-size:11px;
  padding:10px;
}

@media(max-width:800px){

  .controls{
    grid-template-columns:repeat(2,1fr);
  }

  .stats{
    grid-template-columns:repeat(3,1fr);
  }

  .grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:500px){

  .container{
    padding:10px;
  }

  h1{
    font-size:20px;
  }

  .controls{
    grid-template-columns:1fr 1fr;
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .grid{
    grid-template-columns:1fr 1fr;
  }

  .card-head{
    align-items:flex-start;
  }
}
</style></head><body><div class="container">  <div class="header"><h1>🚀 اسکنر Pump Bybit</h1>

<div class="subtitle">
  شناسایی ارزهای واقعاً پامپ‌شده در تایم‌فریم ۱۵ دقیقه
  <br>
  PUMP → RED CANDLE → PULLBACK ZONE → RETEST
</div>

<div id="status" class="status">
  🟡 در حال بررسی اتصال...
</div>

  </div>  <div class="controls"><button
  id="startBtn"
  class="start"
  onclick="startScanner()">
  ▶️ شروع اسکن
</button>

<button
  id="stopBtn"
  class="stop"
  onclick="stopScanner()"
  disabled>
  ⏹ توقف
</button>

<button
  id="soundBtn"
  class="sound"
  onclick="toggleSound()">
  🔊 صدا: روشن
</button>

<button
  class="test"
  onclick="testSound()">
  🔔 تست صدا
</button>

  </div>  <div class="stats"><div class="stat">
  ارز اسکن‌شده
  <b id="scanned">0</b>
</div>

<div class="stat">
  Setup
  <b id="setups">0</b>
</div>

<div class="stat">
  🎯 سیگنال
  <b id="signals">0</b>
</div>

<div class="stat">
  🟡 نزدیک
  <b id="near">0</b>
</div>

<div class="stat">
  🔵 در مسیر
  <b id="approaching">0</b>
</div>

  </div>  <div class="panel"><div class="panel-title">
  🎯 سیگنال‌های Pump + Pullback
</div>

<div id="signalsList">

  <div class="empty">
    هنوز اسکن شروع نشده است.
  </div>

</div>

  </div>  <div class="panel"><div class="panel-title">
  📡 وضعیت اسکن
</div>

<div id="scanInfo" class="empty">
  آماده شروع
</div>

  </div>  <div class="footer">
    Bybit Pump Scanner · 15M · PPR
  </div></div><script>

/* =========================================================
   CONFIG
========================================================= */

const WORKER_URL =
  "https://pump-scanner.29mah12.workers.dev";

const SCAN_INTERVAL =
  45000;


/* =========================================================
   STATE
========================================================= */

let scannerRunning = false;

let scanTimer = null;

let soundEnabled =
  localStorage.getItem(
    "pump_sound"
  ) !== "off";

let audioContext = null;

let knownSignals =
  new Set();


/* =========================================================
   ELEMENTS
========================================================= */

const statusEl =
  document.getElementById(
    "status"
  );

const scanInfoEl =
  document.getElementById(
    "scanInfo"
  );

const signalsListEl =
  document.getElementById(
    "signalsList"
  );


/* =========================================================
   SOUND
========================================================= */

function getAudioContext(){

  if(!audioContext){

    audioContext =
      new (
        window.AudioContext ||
        window.webkitAudioContext
      )();

  }

  return audioContext;
}


function playAlert(){

  if(!soundEnabled){
    return;
  }

  try{

    const ctx =
      getAudioContext();

    if(ctx.state === "suspended"){
      ctx.resume();
    }

    const now =
      ctx.currentTime;

    /*
      سه بوق برای سیگنال
    */

    [0,0.18,0.36].forEach(
      offset => {

        const oscillator =
          ctx.createOscillator();

        const gain =
          ctx.createGain();

        oscillator.type =
          "sine";

        oscillator.frequency
          .setValueAtTime(
            880,
            now + offset
          );

        gain.gain
          .setValueAtTime(
            0.0001,
            now + offset
          );

        gain.gain.exponentialRampToValueAtTime(
          0.35,
          now + offset + 0.02
        );

        gain.gain.exponentialRampToValueAtTime(
          0.0001,
          now + offset + 0.15
        );

        oscillator.connect(gain);

        gain.connect(
          ctx.destination
        );

        oscillator.start(
          now + offset
        );

        oscillator.stop(
          now + offset + 0.16
        );

      }
    );

  }catch(error){

    console.error(
      "Sound error:",
      error
    );

  }

}


function testSound(){

  soundEnabled = true;

  localStorage.setItem(
    "pump_sound",
    "on"
  );

  updateSoundButton();

  playAlert();

}


function toggleSound(){

  soundEnabled =
    !soundEnabled;

  localStorage.setItem(
    "pump_sound",
    soundEnabled
      ? "on"
      : "off"
  );

  updateSoundButton();

}


function updateSoundButton(){

  const btn =
    document.getElementById(
      "soundBtn"
    );

  btn.textContent =
    soundEnabled
      ? "🔊 صدا: روشن"
      : "🔇 صدا: خاموش";

}


/* =========================================================
   HEALTH
========================================================= */

async function checkHealth(){

  try{

    const response =
      await fetch(
        WORKER_URL +
        "/health",
        {
          cache:"no-store"
        }
      );

    if(!response.ok){
      throw new Error(
        "HTTP " +
        response.status
      );
    }

    const data =
      await response.json();

    statusEl.textContent =
      "🟢 اتصال برقرار است — " +
      data.source +
      " · تایم‌فریم " +
      data.timeframe;

  }catch(error){

    statusEl.textContent =
      "🔴 اتصال به Worker برقرار نیست";

    console.error(error);

  }

}


/* =========================================================
   START
========================================================= */

async function startScanner(){

  if(scannerRunning){
    return;
  }

  scannerRunning =
    true;

  document.getElementById(
    "startBtn"
  ).disabled = true;

  document.getElementById(
    "stopBtn"
  ).disabled = false;

  statusEl.textContent =
    "🟢 اسکنر فعال است — جستجوی Pump واقعی...";

  /*
    اولین اسکن بلافاصله
  */

  await runScan();

  /*
    سپس هر 45 ثانیه
  */

  if(scannerRunning){

    scanTimer =
      setInterval(
        runScan,
        SCAN_INTERVAL
      );

  }

}


/* =========================================================
   STOP
========================================================= */

function stopScanner(){

  scannerRunning =
    false;

  if(scanTimer){

    clearInterval(
      scanTimer
    );

    scanTimer = null;

  }

  document.getElementById(
    "startBtn"
  ).disabled = false;

  document.getElementById(
    "stopBtn"
  ).disabled = true;

  statusEl.textContent =
    "⏹ اسکن متوقف شد";

  scanInfoEl.textContent =
    "اسکنر متوقف است.";

}


/* =========================================================
   SCAN
========================================================= */

async function runScan(){

  if(!scannerRunning){
    return;
  }

  const started =
    Date.now();

  scanInfoEl.textContent =
    "🔎 در حال اسکن 300 ارز Futures در تایم‌فریم 15M...";

  try{

    const response =
      await fetch(
        WORKER_URL +
        "/scan?t=" +
        Date.now(),
        {
          method:"GET",
          cache:"no-store"
        }
      );

    if(!response.ok){

      throw new Error(
        "HTTP " +
        response.status
      );

    }

    const data =
      await response.json();

    if(!data.ok){

      throw new Error(
        data.error ||
        "Scan failed"
      );

    }

    updateStats(data);

    renderResults(
      data.results || []
    );

    /*
      فقط سیگنال‌های جدید
      باعث صدا می‌شوند.
    */

    const reached =
      (data.results || [])
        .filter(
          x =>
            x.state ===
            "REACHED"
        );

    let newSignal = false;

    for(
      const signal of reached
    ){

      if(
        !knownSignals.has(
          signal.id
        )
      ){

        knownSignals.add(
          signal.id
        );

        newSignal = true;

      }

    }

    /*
      جلوگیری از رشد بی‌نهایت حافظه
    */

    if(
      knownSignals.size > 300
    ){

      const arr =
        Array.from(
          knownSignals
        );

      knownSignals =
        new Set(
          arr.slice(-150)
        );

    }

    if(newSignal){

      playAlert();

      statusEl.textContent =
        "🚨 سیگنال جدید Pump + Pullback پیدا شد!";

    }else{

      statusEl.textContent =
        "🟢 اسکن فعال است — آخرین بررسی موفق";

    }

    const elapsed =
      Date.now() -
      started;

    scanInfoEl.textContent =
      "آخرین اسکن: " +
      new Date().toLocaleTimeString(
        "fa-IR"
      ) +
      " · زمان پردازش: " +
      elapsed +
      "ms" +
      " · اسکن بعدی تا حدود 45 ثانیه";

  }catch(error){

    console.error(
      "Scan error:",
      error
    );

    statusEl.textContent =
      "🔴 خطا در اتصال به Worker";

    scanInfoEl.textContent =
      "خطا: " +
      error.message;

  }

}


/* =========================================================
   STATS
========================================================= */

function updateStats(data){

  document.getElementById(
    "scanned"
  ).textContent =
    data.scannedSymbols ??
    0;

  document.getElementById(
    "setups"
  ).textContent =
    data.setups ??
    data.candidates ??
    0;

  document.getElementById(
    "signals"
  ).textContent =
    data.signals ??
    0;

  document.getElementById(
    "near"
  ).textContent =
    data.near ??
    0;

  document.getElementById(
    "approaching"
  ).textContent =
    data.approaching ??
    0;

}


/* =========================================================
   STATE
========================================================= */

function stateText(state){

  switch(state){

    case "REACHED":
      return "🎯 رسید به Zone";

    case "NEAR":
      return "🟡 نزدیک Zone";

    case "APPROACHING":
      return "🔵 در حال نزدیک شدن";

    case "BELOW_ZONE":
      return "🟣 زیر Zone";

    case "INVALID":
      return "🔴 نامعتبر";

    default:
      return "⚪ انتظار";

  }

}


function stateClass(state){

  switch(state){

    case "REACHED":
      return "reached";

    case "NEAR":
      return "near";

    case "APPROACHING":
      return "approaching";

    case "BELOW_ZONE":
      return "below";

    case "INVALID":
      return "invalid";

    default:
      return "below";

  }

}


/* =========================================================
   NUMBER
========================================================= */

function fmt(value, digits = 2){

  if(
    value === null ||
    value === undefined ||
    !Number.isFinite(
      Number(value)
    )
  ){

    return "-";

  }

  return Number(value)
    .toLocaleString(
      "en-US",
      {
        maximumFractionDigits:
          digits
      }
    );

}


/* =========================================================
   TIME
========================================================= */

function formatTime(timestamp){

  if(!timestamp){
    return "-";
  }

  return new Date(
    timestamp
  ).toLocaleString(
    "fa-IR",
    {
      hour:"2-digit",
      minute:"2-digit",
      month:"2-digit",
      day:"2-digit"
    }
  );

}


/* =========================================================
   RENDER
========================================================= */

function renderResults(results){

  if(!results.length){

    signalsListEl.innerHTML = `
      <div class="empty">
        🔎 در آخرین اسکن هیچ Pump معتبر
        همراه با Pullback پیدا نشد.
        <br><br>
        اسکنر همچنان در حال جستجو است.
      </div>
    `;

    return;
  }

  signalsListEl.innerHTML =
    results.map(
      item => renderCard(item)
    ).join("");

}


/* =========================================================
   CARD
========================================================= */

function renderCard(item){

  const pump =
    item.pump || {};

  const pullback =
    item.pullback || {};

  const isSignal =
    item.state ===
    "REACHED";

  return `

    <div class="card">

      <div class="card-head">

        <div class="symbol">
          ${escapeHtml(
            item.symbol
          )}

          ${
            isSignal
              ? " 🚨"
              : ""
          }
        </div>

        <div class="badge ${
          stateClass(
            item.state
          )
        }">

          ${stateText(
            item.state
          )}

        </div>

      </div>


      <div class="grid">

        <div class="info">
          <small>قیمت فعلی</small>
          <strong>
            ${fmt(
              item.currentPrice,
              8
            )}
          </strong>
        </div>

        <div class="info">
          <small>درصد Pump</small>
          <strong>
            ${fmt(
              pump.percent,
              2
            )}%
          </strong>
        </div>

        <div class="info">
          <small>حجم Pump</small>
          <strong>
            ${fmt(
              pump.volumeRatio,
              2
            )}x
          </strong>
        </div>

        <div class="info">
          <small>امتیاز Pump</small>
          <strong>
            ${fmt(
              pump.score,
              0
            )}
          </strong>
        </div>

      </div>


      <div class="pump-box">

        <div class="pump-title">
          🚀 اطلاعات Pump
        </div>

        <div class="grid">

          <div class="info">
            <small>قیمت پایه</small>
            <strong>
              ${fmt(
                pump.basePrice,
                8
              )}
            </strong>
          </div>

          <div class="info">
            <small>قیمت پایان Pump</small>
            <strong>
              ${fmt(
                pump.price,
                8
              )}
            </strong>
          </div>

          <div class="info">
            <small>بیشترین قیمت</small>
            <strong>
              ${fmt(
                pump.high,
                8
              )}
            </strong>
          </div>

          <div class="info">
            <small>تعداد کندل</small>
            <strong>
              ${pump.candles ?? "-"}
            </strong>
          </div>

        </div>

      </div>


      <div class="pump-box">

        <div class="pump-title">
          🔴 Pullback Zone
        </div>

        <div class="grid">

          <div class="info">
            <small>Zone پایین</small>
            <strong>
              ${fmt(
                pullback.zoneLow,
                8
              )}
            </strong>
          </div>

          <div class="info">
            <small>Zone بالا</small>
            <strong>
              ${fmt(
                pullback.zoneHigh,
                8
              )}
            </strong>
          </div>

          <div class="info">
            <small>قیمت بسته شدن</small>
            <strong>
              ${fmt(
                pullback.close,
                8
              )}
            </strong>
          </div>

          <div class="info">
            <small>بدنه قرمز</small>
            <strong>
              ${fmt(
                pullback.bodyPercent,
                2
              )}%
            </strong>
          </div>

        </div>

      </div>


      <div style="
        margin-top:10px;
        color:#8197ad;
        font-size:11px;
      ">

        Pump:
        ${formatTime(
          pump.startTime
        )}
        →
        ${formatTime(
          pump.endTime
        )}

        ·

        Pullback:
        ${formatTime(
          pullback.time
        )}

      </div>

    </div>

  `;

}


/* =========================================================
   ESCAPE
========================================================= */

function escapeHtml(value){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* =========================================================
   INIT
========================================================= */

updateSoundButton();

checkHealth();

</script></body>
</html>
